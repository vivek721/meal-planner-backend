# Docker Environment Configuration
# This file contains environment variables for Docker Compose
# Copy this to .env.docker.local and customize as needed

# Server Configuration
PORT=3001
ENVIRONMENT=development

# Database Configuration
# IMPORTANT: Use 'postgres' as hostname (Docker service name), not 'localhost'
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meal_planner?sslmode=disable

# Individual DB params (if not using DATABASE_URL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=meal_planner
DB_SSLMODE=disable

# JWT Configuration
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24

# Security Configuration
BCRYPT_COST=12

# CORS Configuration
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=100

# TheMealDB recipe source (public key 1 is for development/educational use)
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
MEALDB_TIMEOUT_SECONDS=5
MEALDB_DETAIL_TTL_HOURS=168
MEALDB_SEARCH_TTL_HOURS=24
MEALDB_CACHE_RETENTION_DAYS=30

# USDA FoodData Central (nutrition estimates)
# Get a free key at https://api.data.gov/signup/ - DEMO_KEY allows only 10 requests/hour
USDA_API_KEY=DEMO_KEY
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_TIMEOUT_SECONDS=5
USDA_MATCH_TTL_HOURS=720
USDA_FOOD_TTL_HOURS=2160
NUTRITION_TTL_HOURS=168

# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meal_planner
