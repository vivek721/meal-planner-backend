# Environment Configuration Example
# Copy this file to .env and update the values

# Server Configuration
PORT=3001
ENVIRONMENT=development

# Database Configuration
# Option 1: Use DATABASE_URL (recommended)
# For local development: postgresql://postgres:postgres@localhost:5432/meal_planner?sslmode=disable
# For Docker: postgresql://postgres:postgres@postgres:5432/meal_planner?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meal_planner?sslmode=disable

# Option 2: Use individual database parameters
DB_HOST=localhost          # Use 'postgres' when running in Docker
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=meal_planner
DB_SSLMODE=disable

# JWT Configuration
# IMPORTANT: Change this to a strong secret in production (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION_HOURS=24

# Security Configuration
BCRYPT_COST=12

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MIN=100

# TheMealDB recipe source (public key 1 is for development/educational use)
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
MEALDB_TIMEOUT_SECONDS=5
MEALDB_DETAIL_TTL_HOURS=168
MEALDB_SEARCH_TTL_HOURS=24
MEALDB_CACHE_RETENTION_DAYS=30

# USDA FoodData Central (nutrition estimates)
# Get a free key at https://api.data.gov/signup/ - DEMO_KEY allows only 10 requests/hour
USDA_API_KEY=DEMO_KEY
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_TIMEOUT_SECONDS=5
USDA_MATCH_TTL_HOURS=720
USDA_FOOD_TTL_HOURS=2160
NUTRITION_TTL_HOURS=168

# Docker Notes:
# When running with Docker Compose:
# 1. The DATABASE_URL should use 'postgres' as the hostname (Docker service name)
# 2. You can override these values in docker-compose.yml
# 3. Never commit .env to version control
